        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证、连接和通知设置属于主机。切换到主机以更改这些设置。静态配置是此 Agent 自己的文件。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení ověřování, připojení a oznámení patří hostiteli. Pro jejich změnu přepněte na hostitele. Statická konfigurace je vlastní soubor tohoto agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillinger for godkendelse, forbindelse og notifikationer hører til værten. Skift til værten for at ændre dem. Statisk konfiguration er denne agents egen fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen für Authentifizierung, Verbindung und Benachrichtigungen gehören zum Host. Wechsle zum Host, um sie zu ändern. Die statische Konfiguration ist die eigene Datei dieses Agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de autenticación, conexión y notificaciones pertenecen al host. Cambia al host para modificarlos. La configuración estática es el archivo propio de este agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres d’authentification, de connexion et de notification appartiennent à l’hôte. Passez sur l’hôte pour les modifier. La configuration statique est le fichier propre à cet agent."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres d’authentification, de connexion et de notification appartiennent à l’hôte. Passez à l’hôte pour les modifier. La configuration statique est le fichier propre à cet agent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen voor authenticatie, verbinding en meldingen horen bij de host. Wissel naar de host om ze te wijzigen. De statische configuratie is het eigen bestand van deze agent."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições de autenticação, ligação e notificações pertencem ao anfitrião. Mudar para o anfitrião para as alterar. A configuração estática é o ficheiro próprio deste agente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de autenticação, conexão e notificação pertencem ao host. Mude para o host para alterá-las. A configuração estática é o arquivo próprio deste agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки аутентификации, подключения и уведомлений относятся к хосту. Чтобы изменить их, переключитесь на хост. Статическая конфигурация хранится в собственном файле этого агента."
          }
        }
      }
    },
