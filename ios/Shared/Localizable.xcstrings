    "Hiding a tab here hides it in the app and the web UI for this server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此隐藏的标签页，也会在此服务器的应用和 Web 界面中隐藏。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytím karty zde ji skryjete v aplikaci i ve webovém rozhraní tohoto serveru."
          }
        },
        "da": {
