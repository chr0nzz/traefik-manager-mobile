    "Remove plugin \"%@\"? Traefik keeps running it until it restarts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除插件“%@”？Traefik 重启前会继续运行该插件。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat plugin „%@“? Traefik ho dál používá, dokud se nerestartuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern pluginet \"%@\"? Traefik bliver ved med at køre det, indtil den genstarter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugin „%@“ entfernen? Traefik führt es bis zum Neustart weiter aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar el plugin \"%@\"? Traefik lo sigue ejecutando hasta que se reinicie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le plugin « %@ » ? Traefik continue de l’exécuter jusqu’à son redémarrage."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le plugin « %@ »? Traefik continue de l’exécuter jusqu’à son redémarrage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug-in “%@” verwijderen? Traefik blijft de plug-in uitvoeren tot het herstart."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o plugin \"%@\"? O Traefik continua a executá-lo até ser reiniciado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o plugin \"%@\"? O Traefik continua executando-o até reiniciar."
          }
        },
        "ru": {
