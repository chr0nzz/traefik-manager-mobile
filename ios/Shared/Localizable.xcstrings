    "%lld still serve routes, so Traefik requests new certificates for them.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld still serves routes, so Traefik requests a new certificate for it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld still serve routes, so Traefik requests new certificates for them."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "其中 %lld 个仍在为路由提供服务，因此 Traefik 会为其申请新证书。"
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Jeden certifikát stále obsluhuje trasu, takže si pro něj Traefik vyžádá nový."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld certifikáty stále obsluhují trasy, takže si pro ně Traefik vyžádá nové."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld certifikátů stále obsluhuje trasy, takže si pro ně Traefik vyžádá nové."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld certifikátů stále obsluhuje trasy, takže si pro ně Traefik vyžádá nové."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Et af dem betjener stadig en rute, så Traefik anmoder om et nyt certifikat til det."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld betjener stadig ruter, så Traefik anmoder om nye certifikater til dem."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eines davon wird noch von einer Route verwendet, daher fordert Traefik ein neues Zertifikat dafür an."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld davon werden noch von Routen verwendet, daher fordert Traefik neue Zertifikate für sie an."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uno sigue sirviendo una ruta, así que Traefik solicita un certificado nuevo para ella."
