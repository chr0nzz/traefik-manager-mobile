          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zámek je uložen jen v tomto zařízení. Na server se neposílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låsen findes kun på denne enhed. Den sendes ikke til serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
