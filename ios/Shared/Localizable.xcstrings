    "Asked for on launch and whenever the app returns from the background": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时以及每次应用从后台返回时要求解锁"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje se při spuštění a pokaždé, když se aplikace vrátí z pozadí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræves ved start og hver gang appen vender tilbage fra baggrunden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Start abgefragt und immer dann, wenn die App aus dem Hintergrund zurückkehrt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pide al abrir la app y cada vez que vuelve del segundo plano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé au lancement et chaque fois que l’application revient de l’arrière-plan"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé au lancement et chaque fois que l’application revient de l’arrière-plan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevraagd bij het starten en telkens wanneer de app terugkomt uit de achtergrond"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedido ao abrir e sempre que a aplicação regressa do segundo plano"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitado ao abrir o app e sempre que ele volta do segundo plano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивается при запуске и при каждом возврате приложения из фона"
          }
        }
      }
    },
    "Assign a route to a group in its card settings. A group disappears when nothing uses it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在路由的卡片设置中将其分配到分组。分组未被使用时会消失。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasu přiřadíte ke skupině v nastavení její karty. Skupina zmizí, jakmile ji nic nepoužívá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildel en rute til en gruppe i dens kortindstillinger. En gruppe forsvinder, når intet bruger den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weise eine Route in ihren Karteneinstellungen einer Gruppe zu. Eine Gruppe verschwindet, wenn nichts sie verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna una ruta a un grupo en los ajustes de su tarjeta. Un grupo desaparece cuando nada lo usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez une route à un groupe dans les paramètres de sa carte. Un groupe disparaît quand plus rien ne l’utilise."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez une route à un groupe dans les paramètres de sa carte. Un groupe disparaît lorsque plus rien ne l’utilise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs een route toe aan een groep in de kaartinstellingen. Een groep verdwijnt als niets hem gebruikt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribuir uma rota a um grupo nas definições do respetivo cartão. Um grupo desaparece quando nada o usa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribua uma rota a um grupo nas configurações do card dela. Um grupo desaparece quando nada o usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте маршрут группе в настройках его карточки. Группа исчезает, когда её ничто не использует."
          }
        }
      }
    },
