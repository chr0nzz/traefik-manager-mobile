          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez cette clé : elle ne sera plus affichée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar deze sleutel - hij wordt niet opnieuw getoond."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar esta chave - não será mostrada novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde esta chave - ela não será exibida novamente."
          }
        },
