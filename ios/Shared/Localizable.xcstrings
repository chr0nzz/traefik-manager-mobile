    "This middleware was hand-edited. It is kept as-is unless you change a toggle below.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此中间件已被手动编辑。除非更改下方的开关，否则将保持原样。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto middleware bylo upraveno ručně. Zůstane beze změny, pokud nezměníte některý přepínač níže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne middleware er redigeret manuelt. Den bevares uændret, medmindre du ændrer en kontakt nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Middleware wurde von Hand bearbeitet. Sie bleibt unverändert, solange du unten keinen Schalter änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este middleware se editó a mano. Se mantiene tal cual salvo que cambies un interruptor de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce middleware a été modifié manuellement. Il est conservé tel quel, sauf si vous modifiez une option ci-dessous."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce middleware a été modifié manuellement. Il est conservé tel quel, sauf si vous modifiez une option ci-dessous."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze middleware is handmatig bewerkt. Er verandert niets, tenzij je hieronder een schakelaar wijzigt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este middleware foi editado manualmente. Mantém-se como está, a menos que um interruptor abaixo seja alterado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este middleware foi editado à mão. Ele é mantido como está, a menos que você altere uma opção abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот middleware изменён вручную. Он сохраняется как есть, пока вы не измените переключатель ниже."
          }
        }
      }
    },
    "This only removes it from this Traefik Manager. The agent keeps running on that machine with the same key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会将其从此 Traefik Manager 中移除。Agent 会继续使用相同的密钥在该机器上运行。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebere se jen z tohoto Traefik Manageru. Agent na daném stroji dál běží se stejným klíčem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner den kun fra denne Traefik Manager. Agenten kører videre på den maskine med samme nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird er nur aus diesem Traefik Manager entfernt. Der Agent läuft auf seinem Rechner mit demselben Schlüssel weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo quita de este Traefik Manager. El agente sigue funcionando en esa máquina con la misma clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est uniquement supprimé de ce Traefik Manager. L’agent continue de tourner sur cette machine avec la même clé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action le retire uniquement de ce Traefik Manager. L’agent continue de fonctionner sur cette machine avec la même clé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert hem alleen uit deze Traefik Manager. De agent blijft op die machine draaien met dezelfde sleutel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto só o remove deste Traefik Manager. O agente continua a ser executado nessa máquina com a mesma chave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso só o remove deste Traefik Manager. O agente continua rodando naquela máquina com a mesma chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер будет убран только из этого Traefik Manager. Агент продолжит работать на той машине с тем же ключом."
          }
        }
      }
    },
    "This overwrites the live config, replacing every route it holds. The server backs up what is there now first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将覆盖当前生效的配置，替换其中的所有路由。服务器会先备份现有内容。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se přepíše aktivní konfigurace a nahradí všechny trasy, které obsahuje. Server nejprve zazálohuje současný stav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette overskriver den aktive konfiguration og erstatter alle ruter i den. Serveren tager først backup af det, der er der nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies überschreibt die aktive Konfiguration und ersetzt jede darin enthaltene Route. Der Server sichert zuerst den aktuellen Stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sobrescribe la configuración en uso y reemplaza todas las rutas que contiene. Antes, el servidor hace una copia de seguridad de lo que hay ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action écrase la configuration active et remplace toutes les routes qu’elle contient. Le serveur sauvegarde d’abord le contenu actuel."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action écrase la configuration active et remplace toutes les routes qu’elle contient. Le serveur sauvegarde d’abord son contenu actuel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit overschrijft de actieve configuratie en vervangt elke route erin. De server maakt eerst een back-up van wat er nu staat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto sobrescreve a configuração ativa e substitui todas as rotas que contém. O servidor cria primeiro uma cópia de segurança do que existe agora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso sobrescreve a configuração ativa, substituindo todas as rotas que ela contém. Antes, o servidor faz backup do conteúdo atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это перезапишет действующую конфигурацию и заменит все маршруты в ней. Сервер сначала создаст резервную копию текущей версии."
          }
        }
      }
    },
    "This overwrites the live static config. The server backs up what is there now first, and Traefik has to restart before it takes effect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将覆盖当前生效的静态配置。服务器会先备份现有内容，且 Traefik 需要重启后才会生效。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se přepíše aktivní statická konfigurace. Server nejprve zazálohuje současný stav a změna se projeví až po restartu Traefiku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette overskriver den aktive statiske konfiguration. Serveren tager først backup af det, der er der nu, og Traefik skal genstartes, før det træder i kraft."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies überschreibt die aktive statische Konfiguration. Der Server sichert zuerst den aktuellen Stand, und Traefik muss neu starten, bevor die Änderung wirksam wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sobrescribe la configuración estática en uso. Antes, el servidor hace una copia de seguridad de lo que hay ahora, y Traefik tiene que reiniciarse para que surta efecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action écrase la configuration statique active. Le serveur sauvegarde d’abord le contenu actuel, et Traefik doit redémarrer pour que la modification prenne effet."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action écrase la configuration statique active. Le serveur sauvegarde d’abord son contenu actuel, et Traefik doit redémarrer pour que la modification prenne effet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit overschrijft de actieve statische configuratie. De server maakt eerst een back-up van wat er nu staat, en Traefik moet herstarten voordat dit van kracht wordt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto sobrescreve a configuração estática ativa. O servidor cria primeiro uma cópia de segurança do que existe agora e é necessário reiniciar o Traefik para que tenha efeito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso sobrescreve a configuração estática ativa. Antes, o servidor faz backup do conteúdo atual, e o Traefik precisa reiniciar para que entre em vigor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это перезапишет действующую статическую конфигурацию. Сервер сначала создаст резервную копию текущей версии, а чтобы изменения вступили в силу, Traefik нужно перезапустить."
          }
        }
      }
    },
    "This removes the router and its service from the config file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会从配置文件中移除该路由器及其服务。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se router a jeho služba odeberou z konfiguračního souboru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner routeren og dens service fra konfigurationsfilen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden der Router und sein Service aus der Konfigurationsdatei entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto quita el router y su servicio del archivo de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime le routeur et son service du fichier de configuration."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime le routeur et son service du fichier de configuration."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de router en de bijbehorende service uit het configuratiebestand verwijderd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove o router e o respetivo serviço do ficheiro de configuração."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o router e o serviço dele do arquivo de configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это уберёт роутер и его сервис из файла конфигурации."
          }
        }
      }
    },
    "This replaces every certificate in acme.json. The server backs up what is there now first, then restarts Traefik because it only reads acme.json at startup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将替换 acme.json 中的所有证书。服务器会先备份现有内容，然后重启 Traefik，因为 Traefik 只在启动时读取 acme.json。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se nahradí všechny certifikáty v acme.json. Server nejprve zazálohuje současný stav a pak restartuje Traefik, protože ten čte acme.json jen při startu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette erstatter alle certifikater i acme.json. Serveren tager først backup af det, der er der nu, og genstarter derefter Traefik, fordi Traefik kun læser acme.json ved opstart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt jedes Zertifikat in acme.json. Der Server sichert zuerst den aktuellen Stand und startet Traefik dann neu, weil Traefik acme.json nur beim Start liest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplaza todos los certificados de acme.json. Antes, el servidor hace una copia de seguridad de lo que hay ahora y después reinicia Traefik, que solo lee acme.json al arrancar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action remplace tous les certificats de acme.json. Le serveur sauvegarde d’abord le contenu actuel, puis redémarre Traefik, car celui-ci ne lit acme.json qu’au démarrage."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action remplace tous les certificats dans acme.json. Le serveur sauvegarde d’abord son contenu actuel, puis redémarre Traefik, car celui-ci ne lit acme.json qu’au démarrage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vervangt elk certificaat in acme.json. De server maakt eerst een back-up van wat er nu staat en herstart daarna Traefik, omdat Traefik acme.json alleen bij het opstarten leest."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto substitui todos os certificados em acme.json. O servidor cria primeiro uma cópia de segurança do que existe agora e depois reinicia o Traefik, porque este só lê o acme.json no arranque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso substitui todos os certificados no acme.json. Antes, o servidor faz backup do conteúdo atual e depois reinicia o Traefik, porque ele só lê o acme.json na inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это заменит все сертификаты в acme.json. Сервер сначала создаст резервную копию текущей версии, затем перезапустит Traefik, так как он читает acme.json только при запуске."
          }
        }
      }
    },
    "This route uses a %@ service that Traefik Manager manages. Edit its backends from the Services tab.": {
