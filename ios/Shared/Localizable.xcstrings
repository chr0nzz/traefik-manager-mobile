    "The first backend serves. The rest get a copy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一个后端提供服务。其余后端接收副本。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První backend obsluhuje požadavky. Ostatní dostávají kopii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første backend betjener. Resten får en kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erste Backend antwortet. Die übrigen erhalten eine Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer backend atiende. El resto recibe una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier backend sert le trafic. Les autres en reçoivent une copie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier backend sert le trafic. Les autres en reçoivent une copie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste backend bedient het verkeer. De rest krijgt een kopie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro backend serve. Os restantes recebem uma cópia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro backend atende. Os demais recebem uma cópia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый бэкенд обслуживает запросы. Остальные получают копию."
          }
        }
      }
    },
    "The first backend serves. The second takes over if it fails.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一个后端提供服务。若其故障，第二个后端接管。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První backend obsluhuje požadavky. Pokud selže, převezme je druhý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første backend betjener. Den anden tager over, hvis den fejler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erste Backend antwortet. Fällt es aus, übernimmt das zweite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer backend atiende. El segundo toma el relevo si falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier backend sert le trafic. Le second prend le relais en cas de panne."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier backend sert le trafic. Le second prend le relais en cas de panne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste backend bedient het verkeer. De tweede neemt het over als die uitvalt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro backend serve. O segundo assume se o primeiro falhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro backend atende. O segundo assume se ele falhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый бэкенд обслуживает запросы. Второй берёт их на себя, если первый откажет."
          }
        }
      }
    },
    "The first row is primary, the second is the fallback.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一行是主后端，第二行是备用后端。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První řádek je primární, druhý je záložní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første række er primær, den anden er reserven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Zeile ist primär, die zweite ist der Fallback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera fila es la principal, la segunda es la de respaldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première ligne est principale, la deuxième sert de secours."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La première ligne est la principale, la deuxième sert de secours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste rij is primair, de tweede is de fallback."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira linha é a principal, a segunda é a reserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira linha é a principal, a segunda é a reserva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая строка задаёт основной бэкенд, вторая задаёт резервный."
          }
        }
      }
    },
    "The first row serves traffic. The rest mirror it by percent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一行提供服务。其余行按百分比镜像流量。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První řádek obsluhuje provoz. Ostatní ho zrcadlí podle procent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første række betjener trafikken. Resten spejler en procentdel af den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Zeile bedient den Traffic. Die übrigen spiegeln ihn prozentual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera fila sirve el tráfico. Las demás lo replican según un porcentaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première ligne traite le trafic. Les autres en reçoivent une copie selon un pourcentage."
          }
        },
        "fr-CA": {
