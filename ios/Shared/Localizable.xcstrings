    "Covers the browser login. This app authenticates with its API key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于浏览器登录。此应用使用其 API 密钥进行认证。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Týká se přihlášení v prohlížeči. Tato aplikace se ověřuje svým API klíčem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gælder browserlogin. Denne app godkender med sin API-nøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für die Browser-Anmeldung. Diese App authentifiziert sich mit ihrem API-Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al inicio de sesión en el navegador. Esta app se autentica con su clave de API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvre la connexion via le navigateur. Cette application s’authentifie avec sa clé d’API."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à la connexion dans le navigateur. Cette application s’authentifie avec sa clé d’API."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor de browserlogin. Deze app authenticeert met een eigen API-sleutel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrange o início de sessão no navegador. Esta aplicação autentica-se com a respetiva chave de API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobre o login pelo navegador. Este app se autentica com a própria chave de API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распространяется на вход в браузере. Это приложение проходит аутентификацию по своему API-ключу."
          }
        }
      }
    },
    "Create": {
      "localizations": {
