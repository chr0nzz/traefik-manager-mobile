    "Remove \"%@\"? It goes when you save.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除“%@”？保存时才会移除。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat „%@“? Změna se projeví po uložení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern \"%@\"? Det forsvinder, når du gemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ entfernen? Die Änderung wird beim Speichern übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar \"%@\"? Se quitará cuando guardes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? La suppression prend effet à l’enregistrement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ »? La suppression prend effet à l’enregistrement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” verwijderen? Het verdwijnt zodra je opslaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover \"%@\"? É removido ao guardar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover \"%@\"? A remoção é aplicada quando você salvar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать «%@»? Это применится при сохранении."
          }
        }
      }
    },
    "Remove \"%@\"? Push to that phone stops until the app registers again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除“%@”？在该应用重新注册之前，将停止向该手机推送。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat kanál „%@“? Push oznámení na daný telefon přestanou chodit, dokud se aplikace znovu nezaregistruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern \"%@\"? Push til den telefon stopper, indtil appen registrerer sig igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ entfernen? Push an das zugehörige Handy stoppt, bis sich die App erneut registriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar \"%@\"? Las notificaciones push a ese teléfono se detienen hasta que la app se vuelva a registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? Les notifications push vers ce téléphone s’arrêtent jusqu’à ce que l’application s’enregistre à nouveau."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ »? Les notifications push vers ce téléphone s’arrêtent jusqu’à ce que l’application s’enregistre de nouveau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” verwijderen? Push naar die telefoon stopt tot de app zich opnieuw registreert."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover \"%@\"? As notificações push para esse telemóvel param até a aplicação voltar a registar-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover \"%@\"? O push para esse celular é interrompido até o app se registrar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать канал «%@»? Push-уведомления на этот телефон перестанут приходить, пока приложение не зарегистрируется снова."
          }
        }
      }
    },
