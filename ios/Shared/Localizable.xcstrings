    "One per line. Converts gRPC-Web requests to gRPC before forwarding. * allows any origin.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个。转发前将 gRPC-Web 请求转换为 gRPC。* 表示允许任何来源。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden na řádek. Před předáním převádí požadavky gRPC-Web na gRPC. * povolí jakýkoli origin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én pr. linje. Konverterer gRPC-Web-forespørgsler til gRPC før videresendelse. * tillader enhver origin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pro Zeile. Wandelt gRPC-Web-Anfragen vor dem Weiterleiten in gRPC um. * erlaubt jeden Origin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno por línea. Convierte las peticiones gRPC-Web a gRPC antes de reenviarlas. * permite cualquier origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par ligne. Convertit les requêtes gRPC-Web en gRPC avant la transmission. * autorise toutes les origines."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par ligne. Convertit les requêtes gRPC-Web en gRPC avant de les transmettre. * autorise toutes les origines."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén per regel. Zet gRPC-Web-verzoeken om naar gRPC voordat ze worden doorgestuurd. * staat elke origin toe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma por linha. Converte pedidos gRPC-Web em gRPC antes de os encaminhar. * permite qualquer origem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por linha. Converte requisições gRPC-Web em gRPC antes de encaminhar. * permite qualquer origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному в строке. Преобразует запросы gRPC-Web в gRPC перед передачей. * разрешает любой источник."
          }
        }
      }
    },
    "One per line. Single codes or ranges. Only these responses are replaced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个。单个状态码或范围。仅替换这些响应。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden na řádek. Jednotlivé kódy nebo rozsahy. Nahrazují se pouze tyto odpovědi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én pr. linje. Enkelte koder eller intervaller. Kun disse svar erstattes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pro Zeile. Einzelne Codes oder Bereiche. Nur diese Antworten werden ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno por línea. Códigos individuales o rangos. Solo se reemplazan estas respuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par ligne. Codes individuels ou plages. Seules ces réponses sont remplacées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par ligne. Codes uniques ou plages. Seules ces réponses sont remplacées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén per regel. Losse codes of bereiken. Alleen deze responses worden vervangen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por linha. Códigos únicos ou intervalos. Só estas respostas são substituídas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por linha. Códigos únicos ou faixas. Só essas respostas são substituídas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному в строке. Отдельные коды или диапазоны. Заменяются только эти ответы."
          }
        }
      }
    },
    "One per line. The matched prefix is removed before the request is forwarded. Anchor with ^ or it can match mid-path.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个。转发请求前会移除匹配到的前缀。用 ^ 锚定，否则可能在路径中间匹配。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden na řádek. Odpovídající prefix se před předáním požadavku odstraní. Ukotvěte ho pomocí ^, jinak se může shodovat i uprostřed cesty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én pr. linje. Det matchede præfiks fjernes, før forespørgslen videresendes. Forankr med ^, ellers kan det matche midt i stien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pro Zeile. Das passende Präfix wird entfernt, bevor die Anfrage weitergeleitet wird. Verankere mit ^, sonst kann es mitten im Pfad passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno por línea. El prefijo que coincide se quita antes de reenviar la petición. Ánclalo con ^ o puede coincidir en mitad del path."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une par ligne. Le préfixe correspondant est retiré avant la transmission de la requête. Ancrez-la avec ^, sinon elle peut correspondre au milieu du chemin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par ligne. Le préfixe correspondant est retiré avant la transmission de la requête. Ancrez-le avec ^, sinon il peut correspondre au milieu du chemin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén per regel. Het overeenkomende prefix wordt verwijderd voordat het verzoek wordt doorgestuurd. Veranker met ^, anders kan het midden in het pad overeenkomen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por linha. O prefixo correspondente é removido antes de o pedido ser encaminhado. Ancorar com ^, caso contrário pode corresponder a meio do caminho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por linha. O prefixo correspondente é removido antes de a requisição ser encaminhada. Ancore com ^ ou ele pode corresponder no meio do caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному в строке. Совпавший префикс удаляется перед передачей запроса. Привязывайте к началу через ^, иначе совпадение возможно в середине пути."
          }
        }
      }
    },
