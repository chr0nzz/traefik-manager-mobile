    "Traefik Manager reads routes, services and middlewares from this API. With it off those tabs are empty.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager 从此 API 读取路由、服务和中间件。关闭后，这些标签页将为空。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager načítá trasy, služby a middleware z tohoto API. Když je vypnuté, jsou tyto karty prázdné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager læser ruter, services og middlewares fra dette API. Er det slået fra, er de faner tomme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager liest Routen, Services und Middlewares aus dieser API. Ist sie aus, sind diese Tabs leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager lee las rutas, los servicios y los middlewares de esta API. Si está desactivada, esas pestañas quedan vacías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager lit les routes, services et middlewares depuis cette API. Si elle est désactivée, ces onglets sont vides."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager lit les routes, services et middlewares depuis cette API. Si elle est désactivée, ces onglets sont vides."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager leest routes, services en middlewares uit deze API. Als die uit staat, zijn die tabbladen leeg."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traefik Manager lê rotas, serviços e middlewares a partir desta API. Com ela desativada, esses separadores ficam vazios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traefik Manager lê rotas, serviços e middlewares desta API. Com ela desativada, essas abas ficam vazias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik Manager читает маршруты, сервисы и middleware из этого API. Если он отключён, эти вкладки пусты."
          }
        }
      }
    },
