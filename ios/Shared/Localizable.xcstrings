    "This server is too old for the client IP diagnostic. Requires Traefik Manager 1.8.0 or newer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器版本过旧，不支持客户端 IP 诊断。需要 Traefik Manager 1.8.0 或更高版本。"
          }
        },
        "cs": {
          "stringUnit": {
