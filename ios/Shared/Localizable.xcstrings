    "Registered by the Traefik Manager app on your phone. Editing it stops push to that device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由您手机上的 Traefik Manager 应用注册。编辑后将停止向该设备推送。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrováno aplikací Traefik Manager ve vašem telefonu. Úprava zastaví push oznámení do tohoto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreret af Traefik Manager-appen på din telefon. Hvis du redigerer den, stopper push til den enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Traefik Manager-App auf deinem Handy registriert. Wenn du es bearbeitest, stoppt Push an dieses Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado por la app de Traefik Manager en tu teléfono. Editarlo detiene las notificaciones push a ese dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré par l’application Traefik Manager sur votre téléphone. Toute modification interrompt les notifications push vers cet appareil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré par l’application Traefik Manager sur votre téléphone. Toute modification interrompt les notifications push vers cet appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geregistreerd door de Traefik Manager-app op je telefoon. Als je dit bewerkt, stopt push naar dat apparaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registado pela aplicação Traefik Manager no telemóvel. Editá-lo interrompe as notificações push para esse dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado pelo app Traefik Manager no seu celular. Editá-lo interrompe o push para esse dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрирован приложением Traefik Manager на вашем телефоне. Изменение остановит push-уведомления на это устройство."
          }
        }
      }
    },
    "Reject - 400 on underscore headers": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝 - 对下划线标头返回 400"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmítnout: 400 u hlaviček s podtržítkem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afvis - 400 ved headers med understregning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablehnen - 400 bei Headern mit Unterstrich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechazar - 400 en cabeceras con guion bajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeter : erreur 400 pour les en-têtes contenant des traits de soulignement"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuser : erreur 400 pour les en-têtes contenant des traits de soulignement"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afwijzen - 400 bij headers met underscore"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeitar - 400 em cabeçalhos com underscore"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeitar - 400 em cabeçalhos com sublinhado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонить: 400 для заголовков с подчёркиванием"
          }
        }
      }
    },
