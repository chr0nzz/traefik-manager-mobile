        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky agentům jeden Traefik Manager dosáhne na Traefik na jiných strojích. Samotný hostitel je dostupný vždy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter lader én Traefik Manager nå Traefik på andre maskiner. Værten selv er altid tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Agents erreicht ein Traefik Manager Traefik auf anderen Rechnern. Der Host selbst ist immer verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes permiten que un Traefik Manager acceda a Traefik en otras máquinas. El propio host siempre está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents permettent à un seul Traefik Manager d’accéder à Traefik sur d’autres machines. L’hôte lui-même est toujours disponible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents permettent à un seul Traefik Manager d’atteindre Traefik sur d’autres machines. L’hôte lui-même est toujours disponible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met agents bereikt één Traefik Manager Traefik op andere machines. De host zelf is altijd beschikbaar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes permitem que um Traefik Manager aceda ao Traefik noutras máquinas. O próprio anfitrião está sempre disponível."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
