    "Remove channel \"%@\"? Events will stop being delivered to it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除渠道“%@”？事件将不再发送到该渠道。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat kanál „%@“? Události do něj přestanou být doručovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern kanalen \"%@\"? Hændelser leveres ikke længere til den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal „%@“ entfernen? Ereignisse werden nicht mehr an ihn zugestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar el canal \"%@\"? Los eventos dejarán de entregarse en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le canal « %@ » ? Les événements ne lui seront plus transmis."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le canal « %@ »? Les événements ne lui seront plus transmis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanaal “%@” verwijderen? Gebeurtenissen worden er dan niet meer naartoe gestuurd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o canal \"%@\"? Os eventos deixam de lhe ser entregues."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o canal \"%@\"? Os eventos deixarão de ser entregues a ele."
