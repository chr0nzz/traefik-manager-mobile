    "Close and reopen Traefik Manager to switch to %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭并重新打开 Traefik Manager 以切换到%@。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavřete a znovu otevřete Traefik Manager, aby se přepnul na %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk og åbn Traefik Manager igen for at skifte til %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe Traefik Manager und öffne es erneut, um zu %@ zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra y vuelve a abrir Traefik Manager para cambiar a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez puis rouvrez Traefik Manager pour passer en %@."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez puis rouvrez Traefik Manager pour passer en %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Traefik Manager en open het opnieuw om over te schakelen naar %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche e volte a abrir o Traefik Manager para mudar para %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche e abra o Traefik Manager novamente para mudar para %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте и снова откройте Traefik Manager, чтобы переключиться на %@."
          }
        }
      }
    },
    "Colours the status dot on Routes, and alerts under the Traefik category when a backend stops answering.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为路由页面上的状态点着色，并在后端停止响应时在 Traefik 类别下发出告警。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obarvuje stavovou tečku v Trasách a upozorní v kategorii Traefik, když backend přestane odpovídat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farver statusprikken på Ruter og advarer under kategorien Traefik, når en backend holder op med at svare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt den Statuspunkt unter Routen und benachrichtigt in der Kategorie Traefik, wenn ein Backend nicht mehr antwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorea el punto de estado en Rutas y envía alertas en la categoría Traefik cuando un backend deja de responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore le point d’état dans Routes et envoie une alerte dans la catégorie Traefik quand un backend ne répond plus."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore le point d’état dans Routes et envoie une alerte dans la catégorie Traefik lorsqu’un backend cesse de répondre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleurt de statusstip op Routes en waarschuwt onder de categorie Traefik wanneer een backend niet meer antwoordt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore o ponto de estado em Rotas e envia alertas na categoria Traefik quando um backend deixa de responder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore o ponto de status em Rotas e gera alertas na categoria Traefik quando um backend para de responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивает точку статуса в разделе Маршруты и отправляет уведомление в категории Traefik, когда бэкенд перестаёт отвечать."
          }
        }
      }
    },
