    "Switched on but not answering, so the password login still applies": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启但无响应，因此仍使用密码登录"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnuto, ale neodpovídá, takže stále platí přihlášení heslem"
