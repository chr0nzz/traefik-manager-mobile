        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renommage déplace le routeur, son service et les middlewares qui lui sont propres"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoemen verplaatst de router, de bijbehorende service en eventuele eigen middlewares"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar o nome move o router, o respetivo serviço e qualquer middleware próprio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomear move o router, o serviço dele e qualquer middleware próprio"
