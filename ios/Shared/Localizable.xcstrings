    "Edit the settings for your needs. Replace every placeholder and any {{ }} block with real values or Traefik will crash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据需要编辑设置。将所有占位符和任何 {{ }} 块替换为实际值，否则 Traefik 会崩溃。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte nastavení podle svých potřeb. Každý zástupný symbol a každý blok {{ }} nahraďte skutečnými hodnotami, jinak Traefik spadne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger indstillingerne efter dit behov. Erstat alle pladsholdere og eventuelle {{ }}-blokke med rigtige værdier, ellers crasher Traefik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe die Einstellungen an deine Bedürfnisse an. Ersetze jeden Platzhalter und jeden {{ }}-Block durch echte Werte, sonst stürzt Traefik ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la configuración a tus necesidades. Sustituye cada marcador y cualquier bloque {{ }} por valores reales o Traefik se caerá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptez les paramètres à vos besoins. Remplacez chaque valeur d’exemple et tout bloc {{ }} par de vraies valeurs, sinon Traefik plantera."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptez les paramètres à vos besoins. Remplacez chaque espace réservé et tout bloc {{ }} par des valeurs réelles, sinon Traefik plantera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de instellingen aan je wensen aan. Vervang elke placeholder en elk blok met {{ }} door echte waarden, anders crasht Traefik."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar as definições conforme necessário. Substituir todos os marcadores e qualquer bloco {{ }} por valores reais, caso contrário o Traefik vai falhar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite as configurações conforme necessário. Substitua todo valor de exemplo e qualquer bloco {{ }} por valores reais, senão o Traefik vai travar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените настройки под свои нужды. Замените каждый заполнитель и каждый блок {{ }} реальными значениями, иначе Traefik завершится с ошибкой."
          }
        }
      }
    },
    "Edit these in the web UI. Saving here keeps them exactly as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Web 界面中编辑这些设置。在此处保存会原样保留它们。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto hodnoty upravte ve webovém rozhraní. Uložením zde zůstanou přesně tak, jak jsou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger disse i web-UI'et. Gemmer du her, beholdes de præcis, som de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite diese Werte in der Web-UI. Beim Speichern hier bleiben sie genau so, wie sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edítalos en la interfaz web. Guardar aquí los deja exactamente como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez-les dans l’interface web. Un enregistrement ici les conserve tels quels."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez ces valeurs dans l’interface web. L’enregistrement ici les conserve telles quelles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerk deze in de web-UI. Als je hier opslaat, blijven ze precies zoals ze zijn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar estes valores na interface web. Ao guardar aqui, mantêm-se exatamente como estão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite estes valores na interface web. Salvar aqui os mantém exatamente como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяйте их в веб-интерфейсе. При сохранении здесь они остаются без изменений."
          }
        }
      }
    },
