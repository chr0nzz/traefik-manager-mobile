            "state": "translated",
            "value": "Сохраните этот ключ: он больше не будет показан."
          }
        }
      }
    },
    "Save this key - it will not be shown again. The agent stops working until you update it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存此密钥：之后不会再显示。在您更新之前，Agent 将停止工作。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si tento klíč: znovu se nezobrazí. Agent přestane fungovat, dokud ho neaktualizujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem denne nøgle - den vises ikke igen. Agenten holder op med at virke, indtil du opdaterer den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere diesen Schlüssel - er wird nicht erneut angezeigt. Der Agent funktioniert nicht mehr, bis du ihn aktualisierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta clave - no se volverá a mostrar. El agente deja de funcionar hasta que lo actualices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez cette clé : elle ne sera plus affichée. L’agent cesse de fonctionner jusqu’à ce que vous le mettiez à jour."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez cette clé : elle ne sera plus affichée. L’agent cesse de fonctionner jusqu’à ce que vous le mettiez à jour."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar deze sleutel - hij wordt niet opnieuw getoond. De agent werkt niet meer tot je hem bijwerkt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar esta chave - não será mostrada novamente. O agente deixa de funcionar até ser atualizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
