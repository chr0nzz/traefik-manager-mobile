    "Reload the file from the server and lose what you have staged?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从服务器重新加载文件，并丢失已暂存的更改？"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu načíst soubor ze serveru a přijít o připravené změny?"
