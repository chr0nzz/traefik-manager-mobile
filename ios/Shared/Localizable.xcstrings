    "From file provider configs Traefik Manager does not manage, and read-only here. Managed routes are on Routes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 Traefik Manager 未管理的文件提供者配置，在此处为只读。受管理的路由位于路由页面。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z konfigurací poskytovatele file, které Traefik Manager nespravuje, zde jen pro čtení. Spravované trasy najdete v části Trasy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommer fra fil-provider-konfigurationer, som Traefik Manager ikke administrerer, og er skrivebeskyttede her. Administrerede ruter findes under Ruter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stammen aus File-Provider-Konfigurationen, die Traefik Manager nicht verwaltet, und sind hier schreibgeschützt. Verwaltete Routen findest du unter Routen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De configuraciones del proveedor file que Traefik Manager no gestiona, y de solo lectura aquí. Las rutas gestionadas están en Rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Issues de configurations du fournisseur de fichiers que Traefik Manager ne gère pas, et en lecture seule ici. Les routes gérées se trouvent dans Routes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes issues de configurations du fournisseur de fichiers que Traefik Manager ne gère pas, en lecture seule ici. Les routes gérées se trouvent dans Routes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit configuraties voor de file-provider die niet door Traefik Manager worden beheerd, en hier alleen-lezen. Beheerde routes staan onder Routes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Provenientes de configurações do fornecedor de ficheiros que o Traefik Manager não gere, e aqui só de leitura. As rotas geridas estão em Rotas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De configurações do provedor de arquivo que o Traefik Manager não gerencia, e somente leitura aqui. As rotas gerenciadas ficam em Rotas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взяты из конфигураций файлового провайдера, которыми Traefik Manager не управляет, и здесь доступны только для чтения. Управляемые маршруты находятся на вкладке Маршруты."
          }
        }
      }
    },
