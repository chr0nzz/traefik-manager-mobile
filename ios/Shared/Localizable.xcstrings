    "Lost the connection while Traefik restarted. Pull to refresh to check.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik 重启时连接中断。下拉刷新以检查。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojení se ztratilo, zatímco se Traefik restartoval. Pro kontrolu obnovte přetažením dolů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistede forbindelsen, mens Traefik genstartede. Træk ned for at opdatere og tjekke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung beim Neustart von Traefik verloren. Zum Prüfen nach unten ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión mientras Traefik se reiniciaba. Desliza hacia abajo para actualizar y comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion perdue pendant le redémarrage de Traefik. Tirez pour actualiser et vérifier."
          }
        },
        "fr-CA": {
          "stringUnit": {
