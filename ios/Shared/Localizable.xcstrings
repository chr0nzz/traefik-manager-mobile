    "Every browser signed in to the web UI is signed out. API keys, including this app's, keep working.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有登录 Web 界面的浏览器都将退出登录。API 密钥（包括此应用的密钥）仍可继续使用。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny prohlížeče přihlášené do webového rozhraní budou odhlášeny. API klíče, včetně klíče této aplikace, budou fungovat dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle browsere, der er logget ind på web-UI'et, logges ud. API-nøgler, også denne apps, virker fortsat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder in der Web-UI angemeldete Browser wird abgemeldet. API-Schlüssel, auch der dieser App, funktionieren weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierra la sesión de todos los navegadores conectados a la interfaz web. Las claves de API, incluida la de esta app, siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les navigateurs connectés à l’interface web sont déconnectés. Les clés d’API, y compris celle de cette application, continuent de fonctionner."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les navigateurs connectés à l’interface web sont déconnectés. Les clés d’API, y compris celle de cette application, continuent de fonctionner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke browser die in de web-UI is ingelogd, wordt uitgelogd. API-sleutels, ook die van deze app, blijven werken."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os navegadores com sessão iniciada na interface web terminam a sessão. As chaves de API, incluindo a desta aplicação, continuam a funcionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os navegadores conectados à interface web serão desconectados. As chaves de API, incluindo a deste app, continuam funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во всех браузерах будет выполнен выход из веб-интерфейса. API-ключи, включая ключ этого приложения, продолжат работать."
          }
        }
      }
    },
    "Every container is routable unless it opts out.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非容器主动退出，否则所有容器均可路由。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý kontejner lze směrovat, pokud se výslovně nevyřadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver container kan routes, medmindre den fravælger det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Container ist routbar, außer er schließt sich aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los contenedores son enrutables salvo que se excluyan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque conteneur est routable sauf s’il s’exclut."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque conteneur est routable sauf s’il s’exclut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke container is routeerbaar, tenzij hij zich afmeldt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os contentores são encaminháveis, salvo os que optem por ficar de fora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo contêiner é roteável a menos que opte por não ser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый контейнер доступен для маршрутизации, если сам не отказался."
          }
        }
      }
    },
    "Every enabled channel gets its own copy of an event, filtered by the categories, severity, digest and quiet hours set on it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个已启用的渠道都会收到事件的独立副本，并按其设置的类别、严重级别、摘要汇总和免打扰时段进行过滤。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý zapnutý kanál dostane vlastní kopii události, filtrovanou podle kategorií, závažnosti, souhrnu a doby klidu nastavených na něm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver aktiveret kanal får sin egen kopi af en hændelse, filtreret efter de kategorier, den alvorlighed, den opsummering og de stille timer, der er angivet på den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder aktivierte Kanal erhält seine eigene Kopie eines Ereignisses, gefiltert nach den dort eingestellten Kategorien, Schweregrad, Zusammenfassung und Ruhezeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada canal activado recibe su propia copia de un evento, filtrada por las categorías, la gravedad, el resumen y las horas de silencio configuradas en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque canal activé reçoit sa propre copie d’un événement, filtrée selon les catégories, la gravité, le récapitulatif et les heures silencieuses qui lui sont configurés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque canal activé reçoit sa propre copie d’un événement, filtrée selon les catégories, la gravité, le résumé et les heures de silence qui lui sont configurés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk ingeschakeld kanaal krijgt een eigen kopie van een gebeurtenis, gefilterd op de categorieën, ernst, samenvatting en stille uren die erop zijn ingesteld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada canal ativado recebe a sua própria cópia de um evento, filtrada pelas categorias, gravidade, resumo e horas de silêncio nele definidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada canal ativado recebe sua própria cópia de um evento, filtrada pelas categorias, severidade, resumo e horário de silêncio definidos nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый включённый канал получает свою копию события, отфильтрованную по категориям, важности, сводке и тихим часам, заданным для него."
          }
        }
      }
    },
    "Every notification on the server is removed. This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上的所有通知都将被移除。此操作无法撤消。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeberou se všechna oznámení na serveru. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle notifikationer på serveren fjernes. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Benachrichtigungen auf dem Server werden entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitan todas las notificaciones del servidor. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les notifications du serveur sont supprimées. Cette action est irréversible."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les notifications du serveur sont supprimées. Cette action est irréversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke melding op de server wordt verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as notificações no servidor são removidas. Esta ação não pode ser anulada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as notificações no servidor serão removidas. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все уведомления на сервере будут убраны. Это нельзя отменить."
          }
        }
      }
    },
