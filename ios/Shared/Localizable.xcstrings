    "Renaming moves the router, its service and any owned middleware": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重命名会同时移动路由器、其服务和所有专属中间件"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejmenování přesune router, jeho službu a všechna jeho vlastní middleware"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdøbning flytter routeren, dens service og eventuelle tilhørende middlewares"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Umbenennen werden der Router, sein Service und alle zugehörigen Middlewares verschoben"
