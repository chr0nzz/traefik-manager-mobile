    "It is removed from %@, and any left with no backends goes too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从 %@ 中移除，没有剩余后端的服务也会一并删除。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude odebrána ze služeb %@ a ty, kterým nezůstane žádný backend, budou také smazány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fjernes fra %@, og de, der står uden backends bagefter, fjernes også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird aus %@ entfernt, und jeder Service, der danach keine Backends mehr hat, wird ebenfalls gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quita de %@, y los que se queden sin backends también se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est retiré de %@, et tout service qui se retrouve sans backend est aussi supprimé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est retiré de %@, et tout service qui n’a plus de backend est aussi supprimé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij wordt uit %@ verwijderd, en elke service die dan geen backends meer heeft, wordt ook verwijderd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É removido de %@, e os que ficarem sem backends também são removidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço é removido de %@, e os que ficarem sem backends também são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет убран из сервисов %@, а оставшиеся без бэкендов тоже будут удалены."
          }
        }
      }
    },
