    "Comma separated. Offered when you create a route on this server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗号分隔。在此服务器上创建路由时可供选择。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddělené čárkou. Nabízí se při vytváření trasy na tomto serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommasepareret. Tilbydes, når du opretter en rute på denne server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommagetrennt. Wird angeboten, wenn du auf diesem Server eine Route erstellst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separados por comas. Se ofrecen al crear una ruta en este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparés par des virgules. Proposés lors de la création d’une route sur ce serveur."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparés par des virgules. Proposés lors de la création d’une route sur ce serveur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommagescheiden. Aangeboden wanneer je een route op deze server maakt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Separados por vírgulas. Sugeridos ao criar uma rota neste servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separados por vírgula. Oferecidos ao criar uma rota neste servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через запятую. Предлагаются при создании маршрута на этом сервере."
          }
        }
      }
    },
    "Commits every config file as it stands now. A blank message uses the server's own wording.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前状态提交所有配置文件。提交信息留空时使用服务器自己的措辞。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoří commit všech konfiguračních souborů v aktuálním stavu. Když zprávu nevyplníte, použije se výchozí text serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Committer alle konfigurationsfiler, som de er nu. En tom besked bruger serverens egen formulering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Committet jede Konfigurationsdatei im aktuellen Stand. Bei leerer Nachricht verwendet der Server seinen eigenen Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace commit de todos los archivos de configuración en su estado actual. Con el mensaje vacío, se usa el texto del propio servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un commit de tous les fichiers de configuration dans leur état actuel. Sans message, le serveur utilise son propre libellé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectue un commit de tous les fichiers de configuration dans leur état actuel. Si le message est vide, le serveur utilise son propre libellé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt een commit van elk configuratiebestand zoals het nu is. Bij een leeg bericht gebruikt de server een eigen tekst."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz commit de todos os ficheiros de configuração no estado atual. Uma mensagem vazia usa o texto do próprio servidor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz commit de todos os arquivos de configuração como estão agora. Uma mensagem em branco usa o texto do próprio servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт коммит со всеми файлами конфигурации в текущем состоянии. Если сообщение пустое, сервер использует свой текст."
          }
        }
      }
    },
