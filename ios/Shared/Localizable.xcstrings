    "Add a channel to get a message when routes change, backups run or certificates expire.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加渠道，以便在路由变更、备份运行或证书过期时收到消息。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte kanál a dostávejte zprávu, když se změní trasy, proběhnou zálohy nebo vyprší certifikáty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en kanal for at få besked, når ruter ændres, backupper kører eller certifikater udløber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Kanal hinzu, um benachrichtigt zu werden, wenn sich Routen ändern, Backups laufen oder Zertifikate ablaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un canal para recibir un mensaje cuando cambien las rutas, se ejecuten copias de seguridad o caduquen certificados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un canal pour recevoir un message quand les routes changent, les sauvegardes s’exécutent ou les certificats expirent."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un canal pour recevoir un message quand les routes changent, les sauvegardes s’exécutent ou les certificats expirent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een kanaal toe om een bericht te krijgen wanneer routes wijzigen, back-ups draaien of certificaten verlopen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar um canal para receber uma mensagem quando as rotas mudam, as cópias de segurança são executadas ou os certificados expiram."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um canal para receber uma mensagem quando rotas mudarem, backups forem executados ou certificados expirarem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте канал, чтобы получать сообщения при изменении маршрутов, запуске резервного копирования или истечении сертификатов."
          }
        }
      }
    },
