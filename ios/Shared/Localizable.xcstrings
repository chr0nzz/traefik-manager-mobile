    "iOS decides when the app may check in the background, from every 15 minutes to a few hours. For instant alerts, add an ntfy, Pushover or Telegram channel below.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 决定应用何时可在后台检查，间隔从 15 分钟到数小时不等。如需即时提醒，请在下方添加 ntfy、Pushover 或 Telegram 渠道。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O tom, kdy smí aplikace kontrolovat na pozadí, rozhoduje iOS: od každých 15 minut po několik hodin. Pro okamžitá upozornění přidejte níže kanál ntfy, Pushover nebo Telegram."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bestemmer, hvornår appen må tjekke i baggrunden, fra hvert 15. minut til nogle timer. Tilføj en ntfy-, Pushover- eller Telegram-kanal nedenfor for øjeblikkelige advarsler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entscheidet, wann die App im Hintergrund prüfen darf, zwischen alle 15 Minuten und einigen Stunden. Für sofortige Hinweise füge unten einen ntfy-, Pushover- oder Telegram-Kanal hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decide cuándo puede la app comprobar en segundo plano, desde cada 15 minutos hasta unas horas. Para alertas inmediatas, añade abajo un canal de ntfy, Pushover o Telegram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS décide quand l'app peut vérifier en arrière-plan, de toutes les 15 minutes à quelques heures. Pour des alertes immédiates, ajoutez ci-dessous un canal ntfy, Pushover ou Telegram."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS décide quand l'app peut vérifier en arrière-plan, de toutes les 15 minutes à quelques heures. Pour des alertes immédiates, ajoutez ci-dessous un canal ntfy, Pushover ou Telegram."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bepaalt wanneer de app op de achtergrond mag controleren, van elke 15 minuten tot een paar uur. Voeg hieronder een ntfy-, Pushover- of Telegram-kanaal toe voor directe meldingen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS decide quando a app pode verificar em segundo plano, de 15 em 15 minutos a algumas horas. Para alertas imediatos, adicione abaixo um canal ntfy, Pushover ou Telegram."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS decide quando o app pode verificar em segundo plano, de 15 em 15 minutos a algumas horas. Para alertas imediatos, adicione abaixo um canal ntfy, Pushover ou Telegram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS сам решает, когда приложению проверять в фоне: от раза в 15 минут до раза в несколько часов. Для мгновенных оповещений добавьте ниже канал ntfy, Pushover или Telegram."
          }
        }
      }
    },
