    "This writes every config file from that commit over what is running now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会用该提交中的所有配置文件覆盖当前运行的内容。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny konfigurační soubory z tohoto commitu přepíší aktuálně běžící konfiguraci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette overskriver det, der kører nu, med alle konfigurationsfiler fra det commit."
          }
        },
        "de": {
