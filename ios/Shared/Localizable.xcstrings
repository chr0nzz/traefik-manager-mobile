    "Hidden apps stay off the dashboard only. They keep running and still appear on the Routes tab.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏的应用仅不在仪表盘上显示。它们会继续运行，并且仍会出现在路由标签页中。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryté aplikace zmizí jen z přehledu. Dál běží a stále se zobrazují na kartě Trasy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte apps holdes kun væk fra dashboardet. De kører stadig og vises stadig på fanen Ruter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Apps fehlen nur im Dashboard. Sie laufen weiter und erscheinen weiterhin im Routen-Tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps ocultas solo desaparecen del panel. Siguen funcionando y aparecen en la pestaña Rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications masquées disparaissent uniquement du tableau de bord. Elles continuent de fonctionner et restent visibles dans l’onglet Routes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les applications masquées disparaissent uniquement du tableau de bord. Elles continuent de fonctionner et restent visibles dans l’onglet Routes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verborgen apps blijven alleen van het dashboard weg. Ze blijven draaien en verschijnen nog steeds op het tabblad Routes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações ocultas só deixam de aparecer no painel. Continuam em execução e ainda aparecem no separador Rotas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps ocultos ficam fora apenas do painel. Continuam em execução e ainda aparecem na aba Rotas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытые приложения убираются только с дашборда. Они продолжают работать и по-прежнему видны на вкладке «Маршруты»."
          }
        }
      }
    },
