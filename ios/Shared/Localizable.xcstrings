            "value": "%1$lld certificados removidos, mas o Traefik não reiniciou: %2$@. A alteração fica desfeita até que ele reinicie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрано %1$lld сертификатов, но Traefik не перезапустился: %2$@. Изменение не действует, пока он не перезапустится."
          }
        }
      }
    },
    "Removing one restarts Traefik so it lets go of it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除证书会重启 Traefik，使其释放该证书。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrání certifikátu restartuje Traefik, aby ho přestal používat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du fjerner et, genstartes Traefik, så den slipper det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Entfernen wird Traefik neu gestartet, damit es das Zertifikat freigibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al quitar uno se reinicia Traefik para que deje de usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En supprimer un redémarre Traefik pour qu’il le libère."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression d’un certificat redémarre Traefik afin qu’il cesse de l’utiliser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het verwijderen van een certificaat wordt Traefik herstart, zodat het dit loslaat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um certificado reinicia o Traefik, para que este o liberte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um deles reinicia o Traefik para que ele o libere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если убрать сертификат, Traefik перезапустится, чтобы освободить его."
          }
        }
      }
    },
