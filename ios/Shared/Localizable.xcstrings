    "Traefik creates these itself. They are read-only here and turned on or off in your static config.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些由 Traefik 自行创建。它们在此处为只读，需在静态配置中开启或关闭。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto trasy vytváří Traefik sám. Zde jsou jen pro čtení a zapnout nebo vypnout je lze ve vaší statické konfiguraci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik opretter selv disse. De er skrivebeskyttede her og slås til eller fra i din statiske konfiguration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik erstellt diese selbst. Sie sind hier schreibgeschützt und werden in deiner statischen Konfiguration ein- oder ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik las crea por sí mismo. Aquí son de solo lectura y se activan o desactivan en tu configuración estática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik les crée lui-même. Elles sont en lecture seule ici et s’activent ou se désactivent dans votre configuration statique."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik crée ces routes lui-même. Elles sont en lecture seule ici et s’activent ou se désactivent dans votre configuration statique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik maakt deze zelf aan. Ze zijn hier alleen-lezen en worden in je statische configuratie in- of uitgeschakeld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traefik cria-as ele próprio. Aqui são só de leitura e são ativadas ou desativadas na configuração estática."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criadas pelo próprio Traefik. São somente leitura aqui e ativadas ou desativadas na configuração estática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik создаёт их сам. Здесь они доступны только для чтения, а включаются или отключаются в статической конфигурации."
          }
        }
      }
    },
