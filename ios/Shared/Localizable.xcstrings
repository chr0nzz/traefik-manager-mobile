    "Managed by Docker labels and read-only. Edit them through your container's labels.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Docker 标签管理，为只读。通过容器的标签进行编辑。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spravováno štítky Dockeru, jen pro čtení. Trasy upravte ve štítcích svého kontejneru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administreres af Docker-labels og er skrivebeskyttede. Rediger dem via labels på din container."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Docker-Labels verwaltet und schreibgeschützt. Bearbeite sie über die Labels deines Containers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionadas por etiquetas de Docker y de solo lectura. Edítalas en las etiquetas de tu contenedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérées par les labels Docker et en lecture seule. Modifiez-les via les labels de votre conteneur."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes gérées par les labels Docker, en lecture seule. Modifiez-les dans les labels de votre conteneur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheerd via Docker-labels en alleen-lezen. Bewerk ze via de labels van je container."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Geridas por labels do Docker e só de leitura. Editá-las nas labels do contentor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerenciadas por labels do Docker e somente leitura. Edite-as pelas labels do contêiner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляются метками Docker и доступны только для чтения. Изменяйте их через метки вашего контейнера."
          }
        }
      }
    },
