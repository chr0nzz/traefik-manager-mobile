    "Channels arrived in Traefik Manager 1.12.0. This server is older, so it still takes the one webhook.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渠道功能在 Traefik Manager 1.12.0 中引入。此服务器版本较旧，因此仍只使用单个 Webhook。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanály přibyly v Traefik Manageru 1.12.0. Tento server je starší, takže stále používá jediný webhook."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanaler kom med Traefik Manager 1.12.0. Denne server er ældre, så den bruger stadig den ene webhook."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle gibt es seit Traefik Manager 1.12.0. Dieser Server ist älter und nutzt daher noch den einzelnen Webhook."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los canales llegaron en Traefik Manager 1.12.0. Este servidor es anterior, así que todavía usa un único webhook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les canaux sont apparus dans Traefik Manager 1.12.0. Ce serveur est plus ancien, il n’accepte donc qu’un seul webhook."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les canaux sont arrivés dans Traefik Manager 1.12.0. Ce serveur est plus ancien, il n’accepte donc qu’un seul webhook."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalen zijn toegevoegd in Traefik Manager 1.12.0. Deze server is ouder en gebruikt daarom nog één webhook."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os canais foram introduzidos no Traefik Manager 1.12.0. Este servidor é mais antigo, por isso ainda usa o webhook único."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os canais chegaram no Traefik Manager 1.12.0. Este servidor é mais antigo, então ainda usa o webhook único."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каналы появились в Traefik Manager 1.12.0. Этот сервер более старый, поэтому он по-прежнему использует один вебхук."
          }
        }
      }
    },
