    "Where the agent reaches Traefik, not where you do.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 访问 Traefik 的地址，而非您访问的地址。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa, přes kterou se agent spojí s Traefikem, ne ta, kterou používáte vy."
