    "Traefik is restarted afterwards, because it only reads acme.json at startup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后会重启 Traefik，因为它只在启动时读取 acme.json。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté se Traefik restartuje, protože acme.json načítá jen při spuštění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik genstartes bagefter, fordi Traefik kun læser acme.json ved opstart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik wird danach neu gestartet, da Traefik acme.json nur beim Start liest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después se reinicia Traefik, porque solo lee acme.json al arrancar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik est ensuite redémarré, car il ne lit acme.json qu’au démarrage."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik est ensuite redémarré, car il ne lit acme.json qu’au démarrage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traefik wordt daarna herstart, omdat het acme.json alleen bij het opstarten leest."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traefik é reiniciado a seguir, porque só lê acme.json no arranque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Traefik é reiniciado em seguida, porque ele só lê o acme.json na inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем Traefik будет перезапущен, так как он читает acme.json только при запуске."
          }
        }
      }
    },
