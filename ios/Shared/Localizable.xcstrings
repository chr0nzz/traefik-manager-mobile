    "Discovered through Amazon ECS and read-only. Edit them through your ECS task definitions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Amazon ECS 发现，为只读。通过 ECS 任务定义进行编辑。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjištěno přes Amazon ECS, jen pro čtení. Trasy upravte v definicích úloh ECS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdages via Amazon ECS og er skrivebeskyttede. Rediger dem via dine ECS-taskdefinitioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Amazon ECS erkannt und schreibgeschützt. Bearbeite sie über deine ECS-Task-Definitionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubiertas mediante Amazon ECS y de solo lectura. Edítalas en tus definiciones de tareas de ECS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvertes via Amazon ECS et en lecture seule. Modifiez-les via vos définitions de tâches ECS."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes découvertes via Amazon ECS, en lecture seule. Modifiez-les dans vos définitions de tâches ECS."
