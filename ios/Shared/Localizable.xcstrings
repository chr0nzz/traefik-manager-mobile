    "The iOS app is built only on Apple's SDKs and bundles no third-party libraries or fonts. Traefik Manager itself is GPL-3.0.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 应用仅基于 Apple 的 SDK 构建，不含任何第三方库或字体。Traefik Manager 本身采用 GPL-3.0 许可。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace pro iOS je postavena pouze na SDK od Applu a neobsahuje žádné knihovny ani písma třetích stran. Samotný Traefik Manager je pod GPL-3.0."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-appen er kun bygget på Apples SDK'er og indeholder ingen tredjepartsbiblioteker eller skrifttyper. Selve Traefik Manager er GPL-3.0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iOS-App nutzt nur Apples SDKs und enthält keine Bibliotheken oder Schriften von Dritten. Traefik Manager selbst steht unter GPL-3.0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de iOS solo usa los SDK de Apple y no incluye bibliotecas ni fuentes de terceros. Traefik Manager es GPL-3.0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app iOS repose uniquement sur les SDK d'Apple et n'embarque aucune bibliothèque ni police tierce. Traefik Manager est sous GPL-3.0."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app iOS repose uniquement sur les SDK d'Apple et n'embarque aucune bibliothèque ni police tierce. Traefik Manager est sous GPL-3.0."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iOS-app gebruikt alleen de SDK's van Apple en bevat geen bibliotheken of lettertypen van derden. Traefik Manager zelf is GPL-3.0."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app iOS usa apenas os SDK da Apple e não inclui bibliotecas nem tipos de letra de terceiros. O Traefik Manager é GPL-3.0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app iOS usa apenas os SDKs da Apple e não inclui bibliotecas nem fontes de terceiros. O Traefik Manager é GPL-3.0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение для iOS использует только SDK Apple и не содержит сторонних библиотек и шрифтов. Сам Traefik Manager распространяется по GPL-3.0."
          }
        }
      }
    },
    "the link override is not an http or https URL. Fix it in edit": {
