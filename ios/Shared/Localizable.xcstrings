    "Prepended to every router here, comma separated, provider suffix included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预置到此处的每个路由器，以逗号分隔，需包含提供者后缀。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá se na začátek každého routeru zde, oddělené čárkou, včetně přípony poskytovatele."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sættes foran alle routere her, kommasepareret, inkl. provider-suffiks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird jedem Router hier vorangestellt, kommagetrennt, mit Provider-Suffix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se antepone a cada router de este entrypoint, separados por comas, con el sufijo del proveedor incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutés au début de chaque routeur de ce point d’entrée, séparés par des virgules, suffixe du fournisseur inclus."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutés au début des middlewares de chaque routeur de ce point d’entrée, séparés par des virgules, suffixe du fournisseur inclus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt vooraan elke router hier toegevoegd, kommagescheiden, inclusief providersuffix."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionada no início de todos os routers deste entrypoint, separada por vírgulas, com o sufixo do fornecedor incluído."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionada no início de cada router deste entrypoint, separada por vírgulas, com o sufixo do provedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляется перед middleware каждого роутера на этой точке входа, через запятую, с суффиксом провайдера."
          }
        }
      }
    },
