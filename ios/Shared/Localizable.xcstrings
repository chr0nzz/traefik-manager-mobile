    "Bytes. Traefik 3.7 warns on every forward auth without one. Clear it to omit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字节。Traefik 3.7 会对每个未设置此项的 Forward Auth 发出警告。清空即可省略。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajty. Traefik 3.7 varuje u každého forward auth bez této hodnoty. Vymazáním pole hodnotu vynecháte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytes. Traefik 3.7 advarer ved hver forward auth uden en. Ryd feltet for at udelade den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytes. Traefik 3.7 warnt bei jedem Forward Auth ohne diesen Wert. Leere das Feld, um ihn wegzulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytes. Traefik 3.7 muestra un aviso en cada forward auth sin este valor. Vacíalo para omitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En octets. Traefik 3.7 affiche un avertissement pour chaque authentification transférée sans cette valeur. Videz le champ pour l’omettre."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En octets. Traefik 3.7 émet un avertissement pour chaque authentification transférée qui n’en a pas. Videz le champ pour l’omettre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytes. Traefik 3.7 waarschuwt bij elke forward auth zonder deze waarde. Maak het veld leeg om het weg te laten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytes. O Traefik 3.7 emite um aviso em cada forward auth sem este valor. Limpar para omitir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytes. O Traefik 3.7 emite um aviso para cada forward auth sem esse valor. Limpe o campo para omitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В байтах. Traefik 3.7 выдаёт предупреждение для каждого forward auth без этого значения. Очистите поле, чтобы не указывать его."
          }
        }
      }
    },
