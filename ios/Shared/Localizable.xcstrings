    },
    "Anything below this level is dropped for this channel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于此级别的内容在此渠道中会被丢弃。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše pod touto úrovní se pro tento kanál zahodí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt under dette niveau kasseres for denne kanal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles unterhalb dieser Stufe wird für diesen Kanal verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que esté por debajo de este nivel se descarta para este canal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est inférieur à ce niveau est ignoré pour ce canal."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est inférieur à ce niveau est ignoré pour ce canal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles onder dit niveau wordt voor dit kanaal verworpen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que estiver abaixo deste nível é descartado para este canal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo abaixo deste nível é descartado para este canal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё ниже этого уровня отбрасывается для этого канала."
          }
        }
      }
    },
    "Anything signed in with %@ stops working immediately. If it is the key this app uses, you will have to reconnect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 登录的所有内容都将立即失效。如果这是此应用使用的密钥，您需要重新连接。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co je přihlášeno klíčem %@, okamžitě přestane fungovat. Pokud jde o klíč, který používá tato aplikace, budete se muset znovu připojit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, der er logget ind med %@, holder op med at virke med det samme. Hvis det er den nøgle, denne app bruger, skal du forbinde igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was mit %@ angemeldet ist, funktioniert sofort nicht mehr. Wenn diese App diesen Schlüssel verwendet, musst du dich neu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que haya iniciado sesión con %@ deja de funcionar de inmediato. Si es la clave que usa esta app, tendrás que volver a conectarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est connecté avec %@ cesse immédiatement de fonctionner. S’il s’agit de la clé utilisée par cette application, vous devrez vous reconnecter."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est connecté avec %@ cesse de fonctionner immédiatement. S’il s’agit de la clé utilisée par cette application, vous devrez vous reconnecter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat met %@ is ingelogd, werkt meteen niet meer. Als dit de sleutel van deze app is, moet je opnieuw verbinding maken."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que tiver sessão iniciada com %@ deixa de funcionar de imediato. Se for a chave usada por esta aplicação, será necessário voltar a ligar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que estiver conectado com %@ para de funcionar imediatamente. Se for a chave que este app usa, você terá que se reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что использует ключ %@ для входа, сразу перестанет работать. Если это ключ этого приложения, вам придётся подключиться заново."
          }
        }
      }
    },
