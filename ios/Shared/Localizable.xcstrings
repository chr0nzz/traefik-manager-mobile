    "Re-enter the password. The saved one is only sent to the saved API URL.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新输入密码。已保存的密码只会发送到已保存的 API URL。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte heslo znovu. Uložené heslo se odesílá jen na uloženou URL API."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast adgangskoden igen. Den gemte sendes kun til den gemte API-URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Passwort erneut ein. Das gespeicherte wird nur an die gespeicherte API-URL gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a introducir la contraseña. La guardada solo se envía a la URL de la API guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez à nouveau le mot de passe. Le mot de passe enregistré n’est envoyé qu’à l’URL de l’API enregistrée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez de nouveau le mot de passe. Le mot de passe enregistré n’est envoyé qu’à l’URL de l’API enregistrée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het wachtwoord opnieuw in. Het opgeslagen wachtwoord wordt alleen naar de opgeslagen API-URL gestuurd."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzir novamente a palavra-passe. A palavra-passe guardada só é enviada para o URL da API guardado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a senha novamente. A senha salva só é enviada para a URL da API salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль ещё раз. Сохранённый пароль отправляется только на сохранённый URL API."
          }
        }
      }
    },
