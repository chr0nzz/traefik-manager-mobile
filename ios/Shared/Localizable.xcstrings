    "Each device that talks to this server needs its own key. Revoking one only locks out that device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台与此服务器通信的设备都需要自己的密钥。吊销其中一个只会阻止对应设备访问。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zařízení, které komunikuje s tímto serverem, potřebuje vlastní klíč. Odvolání jednoho klíče odepře přístup jen zařízení, kterému patří."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver enhed, der taler med denne server, skal have sin egen nøgle. Tilbagekalder du én, låses kun den enhed ude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gerät, das mit diesem Server kommuniziert, braucht einen eigenen Schlüssel. Wird einer widerrufen, wird nur das zugehörige Gerät ausgesperrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo que se comunica con este servidor necesita su propia clave. Revocar una solo deja fuera a ese dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appareil qui communique avec ce serveur a besoin de sa propre clé. Révoquer une clé ne bloque que l’appareil concerné."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appareil qui communique avec ce serveur a besoin de sa propre clé. En révoquer une ne bloque que cet appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk apparaat dat met deze server praat, heeft een eigen sleutel nodig. Een sleutel intrekken sluit alleen dat apparaat buiten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo que comunica com este servidor precisa de uma chave própria. Revogar uma bloqueia apenas esse dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo que se comunica com este servidor precisa da própria chave. Revogar uma bloqueia apenas esse dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждому устройству, которое подключается к этому серверу, нужен свой ключ. Если отозвать ключ, доступ потеряет только это устройство."
          }
        }
      }
    },
