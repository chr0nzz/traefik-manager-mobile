            "state": "translated",
            "value": "Toute route qui y fait encore référence cessera de fonctionner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke route die er nog naar verwijst, werkt dan niet meer."
          }
        },
        "pt-PT": {
