    "The server hashes the password and appends the user:hash line above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器会对密码进行哈希，并将 user:hash 行追加到上方。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server vytvoří hash hesla a výše připojí řádek user:hash."
          }
        },
        "da": {
