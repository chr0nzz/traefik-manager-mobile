    "Any route still referencing it will stop working.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍引用它的路由将停止工作。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny trasy, které na něj stále odkazují, přestanou fungovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruter, der stadig refererer til den, holder op med at virke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Route, die noch darauf verweist, funktioniert dann nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier ruta que todavía haga referencia a él dejará de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute route qui le référence encore cessera de fonctionner."
          }
        },
        "fr-CA": {
