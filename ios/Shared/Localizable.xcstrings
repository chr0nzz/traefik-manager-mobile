    "%@. CrowdSec only accepts a bouncer key on /v1/decisions, the machine token is refused there, so CROWDSEC_API_KEY has to be set as well.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。CrowdSec 在 /v1/decisions 上只接受 Bouncer 密钥，机器令牌会被拒绝，因此还必须设置 CROWDSEC_API_KEY。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec na /v1/decisions přijímá jen klíč bounceru, token stroje tam odmítá, proto musí být nastaven i CROWDSEC_API_KEY."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec accepterer kun en bouncer-nøgle på /v1/decisions, maskintokenet afvises der, så CROWDSEC_API_KEY skal også være angivet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec akzeptiert auf /v1/decisions nur einen Bouncer-Schlüssel, das Maschinen-Token wird dort abgelehnt, daher muss CROWDSEC_API_KEY ebenfalls gesetzt sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec solo acepta una clave de bouncer en /v1/decisions, allí rechaza el token de máquina, así que también hay que definir CROWDSEC_API_KEY."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec n’accepte qu’une clé de bouncer pour le point de terminaison /v1/decisions ; le jeton de machine y est refusé, la variable CROWDSEC_API_KEY doit donc également être définie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec n’accepte qu’une clé de bouncer sur /v1/decisions; le jeton de machine y est refusé, la variable CROWDSEC_API_KEY doit donc également être définie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec accepteert op /v1/decisions alleen een bouncer-sleutel, het machinetoken wordt daar geweigerd, dus CROWDSEC_API_KEY moet ook ingesteld zijn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. O CrowdSec só aceita uma chave de bouncer em /v1/decisions, o token da máquina é recusado aí, por isso CROWDSEC_API_KEY também tem de estar definida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. O CrowdSec só aceita uma chave de bouncer em /v1/decisions, o token da máquina é recusado lá, então CROWDSEC_API_KEY também precisa ser definida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. CrowdSec принимает на /v1/decisions только ключ баунсера, токен машины там отклоняется, поэтому нужно также задать CROWDSEC_API_KEY."
          }
        }
      }
    },
