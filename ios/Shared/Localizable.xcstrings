    "Save this key - it will not be shown again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存此密钥：之后不会再显示。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si tento klíč: znovu se nezobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem denne nøgle - den vises ikke igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere diesen Schlüssel - er wird nicht erneut angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta clave - no se volverá a mostrar."
          }
        },
