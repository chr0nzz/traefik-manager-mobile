        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Logovat pouze tyto odpovědi, kódy nebo rozsahy oddělené čárkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
