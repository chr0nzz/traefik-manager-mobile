    "Set CROWDSEC_LAPI_URL and a bouncer API key on this server, then recreate the container, to see decisions and alerts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此服务器上设置 CROWDSEC_LAPI_URL 和 Bouncer API 密钥，然后重新创建容器，即可查看决策和告警。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte na tomto serveru CROWDSEC_LAPI_URL a API klíč bounceru, pak znovu vytvořte kontejner, aby se zobrazily decisions a alerty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv CROWDSEC_LAPI_URL og en bouncer-API-nøgle på denne server, og genopret derefter containeren for at se decisions og alerts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze CROWDSEC_LAPI_URL und einen Bouncer-API-Schlüssel auf diesem Server und erstelle dann den Container neu, um Decisions und Alerts zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define CROWDSEC_LAPI_URL y una clave de API de bouncer en este servidor y luego vuelve a crear el contenedor para ver decisiones y alertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez CROWDSEC_LAPI_URL et une clé d’API de bouncer sur ce serveur, puis recréez le conteneur pour voir les décisions et les alertes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir les décisions et les alertes, définissez CROWDSEC_LAPI_URL et une clé d’API de bouncer sur ce serveur, puis recréez le conteneur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel CROWDSEC_LAPI_URL en een bouncer-API-sleutel in op deze server en maak daarna de container opnieuw aan om decisions en alerts te zien."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir CROWDSEC_LAPI_URL e uma chave de API de bouncer neste servidor e depois recriar o contentor para ver decisões e alertas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina CROWDSEC_LAPI_URL e uma chave de API do bouncer neste servidor e depois recrie o contêiner para ver as decisões e os alertas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте CROWDSEC_LAPI_URL и API-ключ баунсера на этом сервере, затем пересоздайте контейнер, чтобы видеть decisions и алерты."
          }
        }
      }
    },
