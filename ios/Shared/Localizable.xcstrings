        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gevonden via Amazon ECS en alleen-lezen. Bewerk ze via je ECS-taakdefinities."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descobertas através do Amazon ECS e só de leitura. Editá-las nas definições de tarefas do ECS."
