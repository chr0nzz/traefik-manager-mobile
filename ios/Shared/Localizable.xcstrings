    "UDP routers have no rule - traffic is matched by entry point only.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP 路由器没有规则：流量仅按入口点匹配。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP routery nemají pravidlo: provoz se přiřazuje pouze podle vstupního bodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP-routere har ingen regel - trafik matches kun efter entrypoint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP-Router haben keine Regel - Traffic wird nur über den Entrypoint zugeordnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los routers UDP no tienen regla - el tráfico se enruta solo por entrypoint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les routeurs UDP n’ont pas de règle - le trafic est acheminé uniquement selon le point d’entrée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les routeurs UDP n’ont pas de règle - le trafic est acheminé uniquement selon le point d’entrée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "UDP-routers hebben geen regel - verkeer wordt alleen op basis van het entrypoint gematcht."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os routers UDP não têm regra - o tráfego é associado apenas pelo entrypoint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Routers UDP não têm regra - o tráfego é roteado apenas pelo entrypoint."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У UDP-роутеров нет правила: трафик сопоставляется только по точке входа."
          }
        }
      }
    },
