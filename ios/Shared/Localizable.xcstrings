    "Hold messages inside this window and send them once it ends. Leave empty for none.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此时间段内暂存消息，并在结束后一并发送。留空表示不设置。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržet zprávy během tohoto okna a odeslat je po jeho skončení. Nechte prázdné, pokud nechcete žádné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold beskeder tilbage i dette tidsrum, og send dem, når det slutter. Lad feltet stå tomt for ingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten in diesem Zeitfenster zurückhalten und nach dessen Ende senden. Leer lassen, um keines festzulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retiene los mensajes dentro de esta franja y los envía cuando termina. Déjalo vacío para no usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre les messages en attente pendant cette plage, puis les envoyer lorsqu’elle se termine. Laissez vide pour désactiver cette option."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre les messages en attente pendant cette plage, puis les envoyer lorsqu’elle se termine. Laissez vide pour désactiver cette option."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd berichten binnen dit venster vast en verstuur ze zodra het afloopt. Laat leeg voor geen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reter as mensagens durante este intervalo e enviá-las quando terminar. Deixar vazio para nenhum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retém as mensagens dentro desta janela e as envia quando ela terminar. Deixe vazio para nenhuma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задерживать сообщения в течение этого окна и отправлять их, когда оно закончится. Оставьте пустым, если не нужно."
          }
        }
      }
    },
