    "Used to verify the record before asking for the certificate, one per line.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在申请证书前验证记录，每行一个。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slouží k ověření záznamu před vyžádáním certifikátu, jeden na řádek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruges til at kontrollere posten, før der anmodes om certifikatet, én pr. linje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden genutzt, um den DNS-Eintrag vor dem Anfordern des Zertifikats zu prüfen, einer pro Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usan para verificar el registro antes de pedir el certificado, uno por línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
