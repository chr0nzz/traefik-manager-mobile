          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usados para verificar o registo antes de pedir o certificado, um por linha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usados para verificar o registro antes de solicitar o certificado, um por linha."
